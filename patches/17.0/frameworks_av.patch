Date: Tue, 10 Nov 2026 00:03:12 +0300
Subject: [PATCH] camera & audiopolicy: Add universal Samsung/CamX vendor tag
 bridge, ISehCameraProvider aux enumeration, and Samsung camcorder mic routing

Change-Id: I0d90b124afb997bbd532c7f800de01c0321cd971
---
 media/libmedia/MediaProfiles.cpp              | 20 ++++-
 .../audiopolicy/enginedefault/src/Engine.cpp  | 23 ++++--
 .../managerdefault/AudioPolicyManager.cpp     | 10 +++
 .../common/hidl/HidlProviderInfo.cpp          | 76 ++++++++++++++++++-
 .../utils/SessionConfigurationUtils.cpp       | 68 ++++++++++++++++-
 5 files changed, 183 insertions(+), 14 deletions(-)

diff --git a/media/libmedia/MediaProfiles.cpp b/media/libmedia/MediaProfiles.cpp
index eae3c1ed25..04b6bc4638 100644
--- a/media/libmedia/MediaProfiles.cpp
+++ b/media/libmedia/MediaProfiles.cpp
@@ -1393,11 +1393,23 @@ Vector<audio_decoder> MediaProfiles::getAudioDecoders() const
 int MediaProfiles::getCamcorderProfileIndex(int cameraId, camcorder_quality quality) const
 {
     int index = -1;
+    bool hasCameraId = false;
     for (size_t i = 0, n = mCamcorderProfiles.size(); i < n; ++i) {
-        if (mCamcorderProfiles[i]->mCameraId == cameraId &&
-            mCamcorderProfiles[i]->mQuality == quality) {
-            index = i;
-            break;
+        if (mCamcorderProfiles[i]->mCameraId == cameraId) {
+            hasCameraId = true;
+            if (mCamcorderProfiles[i]->mQuality == quality) {
+                index = i;
+                break;
+            }
+        }
+    }
+    if (index == -1 && !hasCameraId && cameraId > 0) {
+        for (size_t i = 0, n = mCamcorderProfiles.size(); i < n; ++i) {
+            if (mCamcorderProfiles[i]->mCameraId == 0 &&
+                mCamcorderProfiles[i]->mQuality == quality) {
+                index = i;
+                break;
+            }
         }
     }
     return index;
diff --git a/services/audiopolicy/enginedefault/src/Engine.cpp b/services/audiopolicy/enginedefault/src/Engine.cpp
index 25c223b3a4..0aa9ac0833 100644
--- a/services/audiopolicy/enginedefault/src/Engine.cpp
