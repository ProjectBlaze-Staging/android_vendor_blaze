@@ -0,0 +1,212 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The BlazeAOSP Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.widget;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.AttributeSet;
+import android.view.View;
+import android.view.animation.OvershootInterpolator;
+
+import java.util.Random;
+
+/**
+ * Dynamic Island Capsule + Cute Mascot (BlazeBuddy) peeking down from the top island.
+ * Supports spontaneous blinking, reactive gaze tracking, and iOS 27 / ColorOS 17 island rim.
+ */
+public class PeekingMascotView extends View {
+
+    private final Paint mIslandBgPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mIslandBorderPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mEyePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mShinePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mIslandRect = new RectF();
+    private final RectF mLeftEyeRect = new RectF();
+    private final RectF mRightEyeRect = new RectF();
+
+    private float mBlinkScaleY = 1.0f;
+    private float mGazeOffsetX = 0f;
+    private float mGazeOffsetY = 0f;
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Random mRandom = new Random();
+    private boolean mIsActive = false;
+
+    private final Runnable mBlinkRunnable = new Runnable() {
+        @Override
+        public void run() {
+            if (!mIsActive) return;
+            triggerBlink();
+            long nextDelay = 2400 + mRandom.nextInt(3200);
+            mHandler.postDelayed(this, nextDelay);
+        }
+    };
+
+    public PeekingMascotView(Context context) {
+        this(context, null);
+    }
+
+    public PeekingMascotView(Context context, AttributeSet attrs) {
+        this(context, attrs, 0);
+    }
+
+    public PeekingMascotView(Context context, AttributeSet attrs, int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+        init();
+    }
+
+    private void init() {
+        mIslandBgPaint.setColor(Color.parseColor("#D8090B14"));
+        mIslandBgPaint.setStyle(Paint.Style.FILL);
+
+        mIslandBorderPaint.setColor(Color.parseColor("#45FFFFFF"));
+        mIslandBorderPaint.setStyle(Paint.Style.STROKE);
+        mIslandBorderPaint.setStrokeWidth(dpToPx(1.1f));
+
+        mEyePaint.setColor(Color.parseColor("#70E1FF"));
+        mEyePaint.setStyle(Paint.Style.FILL);
+
+        mShinePaint.setColor(Color.WHITE);
+        mShinePaint.setStyle(Paint.Style.FILL);
+    }
+
+    public void startMascot() {
+        mIsActive = true;
+        mHandler.postDelayed(mBlinkRunnable, 1100);
+    }
+
+    public void stopMascot() {
+        mIsActive = false;
+        mHandler.removeCallbacks(mBlinkRunnable);
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        startMascot();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        stopMascot();
+    }
+
+    private void triggerBlink() {
+        ValueAnimator closeAnim = ValueAnimator.ofFloat(1.0f, 0.08f);
+        closeAnim.setDuration(85);
+        closeAnim.addUpdateListener(anim -> {
+            mBlinkScaleY = (float) anim.getAnimatedValue();
+            invalidate();
+        });
+        closeAnim.start();
+
+        mHandler.postDelayed(() -> {
+            ValueAnimator openAnim = ValueAnimator.ofFloat(0.08f, 1.0f);
+            openAnim.setDuration(155);
+            openAnim.setInterpolator(new OvershootInterpolator(1.8f));
+            openAnim.addUpdateListener(anim -> {
+                mBlinkScaleY = (float) anim.getAnimatedValue();
+                invalidate();
+            });
+            openAnim.start();
+        }, 100);
+    }
+
+    public void setGaze(float touchX, float touchY) {
+        int[] loc = new int[2];
+        getLocationOnScreen(loc);
+        float selfCenterX = loc[0] + getWidth() / 2f;
+        float selfCenterY = loc[1] + getHeight() / 2f;
+
+        float deltaX = touchX - selfCenterX;
+        float deltaY = touchY - selfCenterY;
+        float dist = (float) Math.hypot(deltaX, deltaY);
+
+        if (dist > 0) {
+            float maxOffset = dpToPx(3.5f);
+            mGazeOffsetX = Math.max(-maxOffset, Math.min(maxOffset, (deltaX / dist) * maxOffset));
+            mGazeOffsetY = Math.max(-maxOffset, Math.min(maxOffset, (deltaY / dist) * maxOffset));
+            invalidate();
+        }
+    }
+
+    public void resetGaze() {
+        mGazeOffsetX = 0f;
+        mGazeOffsetY = 0f;
+        invalidate();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        final float width = getWidth();
+        final float height = getHeight();
+        if (width <= 0 || height <= 0) return;
+
+        final float centerY = height / 2f;
+        final float pillW = dpToPx(92f);
+        final float pillH = dpToPx(28f);
+        mIslandRect.set(
+                width / 2f - pillW / 2f,
+                centerY - pillH / 2f,
+                width / 2f + pillW / 2f,
+                centerY + pillH / 2f
+        );
+        canvas.drawRoundRect(mIslandRect, pillH / 2f, pillH / 2f, mIslandBgPaint);
+        canvas.drawRoundRect(mIslandRect, pillH / 2f, pillH / 2f, mIslandBorderPaint);
+
+        final float eyeWidth = dpToPx(8.5f);
+        final float eyeHeight = dpToPx(13f) * mBlinkScaleY;
+        final float eyeSpacing = dpToPx(18f);
+        final float cornerRadius = eyeWidth / 2f;
+
+        final float leftEyeCenterX = width / 2f - eyeSpacing / 2f;
+        final float rightEyeCenterX = width / 2f + eyeSpacing / 2f;
+
+        mLeftEyeRect.set(
+                leftEyeCenterX - eyeWidth / 2f + mGazeOffsetX,
+                centerY - eyeHeight / 2f + mGazeOffsetY,
+                leftEyeCenterX + eyeWidth / 2f + mGazeOffsetX,
+                centerY + eyeHeight / 2f + mGazeOffsetY
+        );
+        canvas.drawRoundRect(mLeftEyeRect, cornerRadius, cornerRadius, mEyePaint);
+
+        mRightEyeRect.set(
+                rightEyeCenterX - eyeWidth / 2f + mGazeOffsetX,
+                centerY - eyeHeight / 2f + mGazeOffsetY,
+                rightEyeCenterX + eyeWidth / 2f + mGazeOffsetX,
+                centerY + eyeHeight / 2f + mGazeOffsetY
+        );
+        canvas.drawRoundRect(mRightEyeRect, cornerRadius, cornerRadius, mEyePaint);
+
+        if (mBlinkScaleY > 0.5f) {
+            float shineRadius = dpToPx(2.1f);
+            canvas.drawCircle(
+                    leftEyeCenterX - dpToPx(1.2f) + mGazeOffsetX,
+                    centerY - dpToPx(2.3f) + mGazeOffsetY,
+                    shineRadius,
+                    mShinePaint
+            );
+            canvas.drawCircle(
+                    rightEyeCenterX - dpToPx(1.2f) + mGazeOffsetX,
+                    centerY - dpToPx(2.3f) + mGazeOffsetY,
+                    shineRadius,
+                    mShinePaint
+            );
+        }
+    }
+
+    private float dpToPx(float dp) {
+        return dp * getResources().getDisplayMetrics().density;
+    }
+}
diff --git a/src/org/lineageos/setupwizard/widget/TouchRippleLayout.java b/src/org/lineageos/setupwizard/widget/TouchRippleLayout.java
new file mode 100644
index 0000000..1d340dc
--- /dev/null
+++ b/src/org/lineageos/setupwizard/widget/TouchRippleLayout.java
@@ -0,0 +1,141 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The BlazeAOSP Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.widget;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.util.AttributeSet;
+import android.view.MotionEvent;
+import android.view.animation.DecelerateInterpolator;
+import android.widget.FrameLayout;
+
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+
+/**
+ * Touch container that renders organic fluid ripples on tap
+ * and drives PeekingMascotView gaze tracking.
+ */
+public class TouchRippleLayout extends FrameLayout {
+
+    private static class Ripple {
+        float x;
+        float y;
+        float radius;
+        int alpha;
+
+        Ripple(float x, float y) {
+            this.x = x;
+            this.y = y;
+            this.radius = 0f;
+            this.alpha = 180;
+        }
+    }
+
+    private final Paint mRipplePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final List<Ripple> mRipples = new ArrayList<>();
+    private PeekingMascotView mMascotView;
+
+    public TouchRippleLayout(Context context) {
+        this(context, null);
+    }
+
+    public TouchRippleLayout(Context context, AttributeSet attrs) {
+        this(context, attrs, 0);
+    }
+
+    public TouchRippleLayout(Context context, AttributeSet attrs, int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+        init();
+    }
+
+    private void init() {
+        setWillNotDraw(false);
+        mRipplePaint.setStyle(Paint.Style.STROKE);
+        mRipplePaint.setStrokeWidth(dpToPx(1.8f));
+        mRipplePaint.setColor(Color.parseColor("#FF6B8B")); // Soft peach-pink
+    }
+
+    public void setMascotView(PeekingMascotView mascotView) {
+        mMascotView = mascotView;
+    }
+
+    @Override
+    public boolean onInterceptTouchEvent(MotionEvent ev) {
+        handleTouch(ev);
+        return super.onInterceptTouchEvent(ev);
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        handleTouch(event);
+        return true;
+    }
+
+    private void handleTouch(MotionEvent event) {
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                addRipple(event.getX(), event.getY());
+                if (mMascotView != null) {
+                    mMascotView.setGaze(event.getRawX(), event.getRawY());
+                }
+                break;
+            case MotionEvent.ACTION_MOVE:
+                if (mMascotView != null) {
+                    mMascotView.setGaze(event.getRawX(), event.getRawY());
+                }
+                break;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                if (mMascotView != null) {
+                    postDelayed(() -> {
+                        if (mMascotView != null) mMascotView.resetGaze();
+                    }, 500);
+                }
+                break;
+        }
+    }
+
+    private void addRipple(float x, float y) {
+        final Ripple ripple = new Ripple(x, y);
+        mRipples.add(ripple);
+
+        ValueAnimator anim = ValueAnimator.ofFloat(0f, 1f);
+        anim.setDuration(600);
+        anim.setInterpolator(new DecelerateInterpolator());
+        final float maxRadius = dpToPx(75f);
+        anim.addUpdateListener(animation -> {
+            float frac = (float) animation.getAnimatedValue();
+            ripple.radius = frac * maxRadius;
+            ripple.alpha = (int) (180 * (1f - frac));
+            invalidate();
+        });
+        anim.start();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        Iterator<Ripple> it = mRipples.iterator();
+        while (it.hasNext()) {
+            Ripple r = it.next();
+            if (r.alpha <= 0) {
+                it.remove();
+            } else {
+                mRipplePaint.setAlpha(r.alpha);
+                canvas.drawCircle(r.x, r.y, r.radius, mRipplePaint);
+            }
+        }
+    }
+
+    private float dpToPx(float dp) {
+        return dp * getResources().getDisplayMetrics().density;
+    }
+}
diff --git a/src/org/lineageos/setupwizard/widget/TypewriterTextView.java b/src/org/lineageos/setupwizard/widget/TypewriterTextView.java
new file mode 100644
index 0000000..513ed2c
--- /dev/null
+++ b/src/org/lineageos/setupwizard/widget/TypewriterTextView.java
@@ -0,0 +1,216 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The BlazeAOSP Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.widget;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.AttributeSet;
+import android.view.View;
+
+/**
+ * ColorOS 17 / iOS 27 Flagship OOBE Typewriter greeting text with glowing cursor,
+ * Living Flow gradient subtitle, and Liquid Glass OS badge pill.
+ */
+public class TypewriterTextView extends View {
+
+    private final Paint mBadgeBgPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mBadgeStrokePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mBadgeTextPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mBadgeDotPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+    private final Paint mGreetingPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mCursorPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mSubtitlePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mBadgeRect = new RectF();
+
+    private final String[] mGreetings = new String[]{
+            "Merhaba.", "Hello.", "你好.", "BlazeAOSP 17."
+    };
+    private final String mSubtitle = "İpeksi Akıcılık. Living Flow ile Tanışın.";
+    private final String mBadgeText = "ANDROID 17  •  BLAZE V5.0 OFFICIAL";
+
+    private int mCurrentIndex = 0;
+    private int mCharCount = 0;
+    private boolean mShowCursor = true;
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private ValueAnimator mCursorAnimator;
+    private OnTypingCompleteListener mListener;
+
+    public interface OnTypingCompleteListener {
+        void onTypingComplete();
+    }
+
+    public TypewriterTextView(Context context) {
+        this(context, null);
+    }
+
+    public TypewriterTextView(Context context, AttributeSet attrs) {
+        this(context, attrs, 0);
+    }
+
+    public TypewriterTextView(Context context, AttributeSet attrs, int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+        init();
+    }
+
+    private void init() {
+        mBadgeBgPaint.setColor(Color.parseColor("#24FFFFFF"));
+        mBadgeBgPaint.setStyle(Paint.Style.FILL);
+
+        mBadgeStrokePaint.setColor(Color.parseColor("#48FFFFFF"));
+        mBadgeStrokePaint.setStyle(Paint.Style.STROKE);
+        mBadgeStrokePaint.setStrokeWidth(dpToPx(1f));
+
+        mBadgeDotPaint.setColor(Color.parseColor("#FF9E44"));
+        mBadgeDotPaint.setStyle(Paint.Style.FILL);
+
+        mBadgeTextPaint.setColor(Color.parseColor("#E6F0FF"));
+        mBadgeTextPaint.setTextSize(spToPx(11f));
+        mBadgeTextPaint.setLetterSpacing(0.08f);
+        mBadgeTextPaint.setTypeface(Typeface.create("sans-serif-medium", Typeface.BOLD));
+
+        mGreetingPaint.setColor(Color.WHITE);
+        mGreetingPaint.setTextSize(spToPx(40f));
+        mGreetingPaint.setTypeface(Typeface.create("sans-serif-medium", Typeface.BOLD));
+        mGreetingPaint.setShadowLayer(dpToPx(12f), 0f, dpToPx(4f), Color.parseColor("#55000000"));
+
+        mCursorPaint.setColor(Color.parseColor("#FF9E44"));
+        mCursorPaint.setTextSize(spToPx(40f));
+        mCursorPaint.setTypeface(Typeface.create("sans-serif-light", Typeface.NORMAL));
+
+        mSubtitlePaint.setTextSize(spToPx(17.5f));
+        mSubtitlePaint.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
+
+        mCursorAnimator = ValueAnimator.ofInt(0, 1);
+        mCursorAnimator.setDuration(450);
+        mCursorAnimator.setRepeatCount(ValueAnimator.INFINITE);
+        mCursorAnimator.setRepeatMode(ValueAnimator.REVERSE);
+        mCursorAnimator.addUpdateListener(anim -> {
+            boolean show = anim.getCurrentPlayTime() % 900 < 450;
+            if (show != mShowCursor) {
+                mShowCursor = show;
+                invalidate();
+            }
+        });
+        mCursorAnimator.start();
+    }
+
+    public void startTyping(OnTypingCompleteListener listener) {
+        mListener = listener;
+        mCurrentIndex = 0;
+        mCharCount = 0;
+        mHandler.removeCallbacksAndMessages(null);
+        typeNextChar();
+    }
+
+    private void typeNextChar() {
+        String currentStr = mGreetings[mCurrentIndex];
+        if (mCharCount < currentStr.length()) {
+            mCharCount++;
+            invalidate();
+            mHandler.postDelayed(this::typeNextChar, 85);
+        } else {
+            mHandler.postDelayed(() -> {
+                if (mCurrentIndex < mGreetings.length - 1) {
+                    mCurrentIndex++;
+                    mCharCount = 0;
+                    invalidate();
+                    mHandler.postDelayed(this::typeNextChar, 95);
+                } else {
+                    if (mListener != null) {
+                        mListener.onTypingComplete();
+                    }
+                }
+            }, 900);
+        }
+    }
+
+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        int width = MeasureSpec.getSize(widthMeasureSpec);
+        int desiredHeight = (int) dpToPx(128f);
+        int height = resolveSize(desiredHeight, heightMeasureSpec);
+        setMeasuredDimension(width, height);
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        if (w > 0) {
+            LinearGradient gradient = new LinearGradient(
+                    0, 0, w * 0.85f, 0,
+                    new int[]{
+                            Color.parseColor("#FFE4B5"),
+                            Color.parseColor("#FF9E6D"),
+                            Color.parseColor("#D8B4FE")
+                    },
+                    null, Shader.TileMode.CLAMP
+            );
+            mSubtitlePaint.setShader(gradient);
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        mHandler.removeCallbacksAndMessages(null);
+        if (mCursorAnimator != null) {
+            mCursorAnimator.cancel();
+        }
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+
+        // 1. Liquid Glass OS Pill Badge
+        float badgeHeight = dpToPx(26f);
+        float textW = mBadgeTextPaint.measureText(mBadgeText);
+        float badgeWidth = textW + dpToPx(34f);
+        mBadgeRect.set(0f, dpToPx(2f), badgeWidth, dpToPx(2f) + badgeHeight);
+        canvas.drawRoundRect(mBadgeRect, badgeHeight / 2f, badgeHeight / 2f, mBadgeBgPaint);
+        canvas.drawRoundRect(mBadgeRect, badgeHeight / 2f, badgeHeight / 2f, mBadgeStrokePaint);
+
+        float dotCx = dpToPx(13f);
+        float dotCy = mBadgeRect.centerY();
+        canvas.drawCircle(dotCx, dotCy, dpToPx(3.5f), mBadgeDotPaint);
+        canvas.drawText(mBadgeText, dpToPx(23f), dotCy + spToPx(3.8f), mBadgeTextPaint);
+
+        // 2. Typewriter Greeting
+        String currentStr = mGreetings[mCurrentIndex];
+        String visibleStr = currentStr.substring(0, Math.min(mCharCount, currentStr.length()));
+
+        float greetingY = dpToPx(74f);
+        canvas.drawText(visibleStr, 0f, greetingY, mGreetingPaint);
+
+        if (mShowCursor) {
+            float textWidth = mGreetingPaint.measureText(visibleStr);
+            canvas.drawText(" |", textWidth, greetingY, mCursorPaint);
+        }
+
+        // 3. Living Flow Subtitle
+        float subtitleY = greetingY + dpToPx(32f);
+        canvas.drawText(mSubtitle, 0f, subtitleY, mSubtitlePaint);
+    }
+
+    private float spToPx(float sp) {
+        return sp * getResources().getDisplayMetrics().scaledDensity;
+    }
+
+    private float dpToPx(float dp) {
+        return dp * getResources().getDisplayMetrics().density;
+    }
+}
