+    private fun updateBlazeUiStyle() {
+        proModeActive = blazePrefs.getBoolean("blaze_pro_mode_active", proModeActive)
+        blazeProControlDeck.isVisible = proModeActive
+        val style = blazePrefs.getString("camera_ui_style", "hasselblad") ?: "hasselblad"
+        val accentColor = when (style) {
+            "hasselblad" -> Color.parseColor("#FF6B00")
+            "leica" -> Color.parseColor("#E60012")
+            "ios_glass" -> Color.parseColor("#FFD60A")
+            else -> Color.parseColor("#38BDF8")
+        }
+        val pillBgColor = when (style) {
+            "hasselblad" -> Color.parseColor("#55FF6B00")
+            "leica" -> Color.parseColor("#55E60012")
+            "ios_glass" -> Color.parseColor("#55FFD60A")
+            else -> Color.parseColor("#4438BDF8")
+        }
+        blazeStyleBadgeButton.text = when (style) {
+            "hasselblad" -> "HASSELBLAD • HNCS"
+            "leica" -> "LEICA • SUMMILUX"
+            "ios_glass" -> "LIQUID GLASS • PRO"
+            else -> "BLAZE CLASSIC"
+        }
+        blazeStyleBadgeButton.strokeColor = android.content.res.ColorStateList.valueOf(accentColor)
+        cameraModeSelectorLayout.setHighlightColor(pillBgColor, accentColor)
+        viewFinderFocus.imageTintList = android.content.res.ColorStateList.valueOf(accentColor)
+        proResetButton.setTextColor(accentColor)
+
+        if (proModeActive) {
+            blazeProModeBadgeButton.text = "PRO AÇIK"
+            blazeProModeBadgeButton.setTextColor(Color.BLACK)
+            blazeProModeBadgeButton.backgroundTintList = android.content.res.ColorStateList.valueOf(accentColor)
+            blazeProModeBadgeButton.strokeColor = android.content.res.ColorStateList.valueOf(accentColor)
+        } else {
+            blazeProModeBadgeButton.text = "PRO"
+            blazeProModeBadgeButton.setTextColor(Color.WHITE)
+            blazeProModeBadgeButton.backgroundTintList = android.content.res.ColorStateList.valueOf(Color.parseColor("#CC1F2937"))
+            blazeProModeBadgeButton.strokeColor = android.content.res.ColorStateList.valueOf(Color.parseColor("#66FFFFFF"))
+        }
+    }
+
+    private fun updateBlazeStabilizationBadge() {
+        val mode = blazePrefs.getString("stabilization_mode", "hybrid") ?: "hybrid"
+        val (label, colorHex) = when (mode) {
+            "hybrid" -> "OIS+EIS ULTRA" to "#10B981"
+            "ois" -> "OIS OPTİK" to "#38BDF8"
+            "eis" -> "EIS SABİT" to "#F59E0B"
+            else -> "OIS/EIS KPL" to "#9CA3AF"
+        }
+        val color = Color.parseColor(colorHex)
+        blazeStabilizationBadgeButton.text = label
+        blazeStabilizationBadgeButton.setTextColor(color)
+        blazeStabilizationBadgeButton.strokeColor = android.content.res.ColorStateList.valueOf(color)
+    }
+
+    private fun applyBlazeCamera2Interop(cameraConfiguration: CameraConfiguration) {
+        val camera2CameraControl = viewModel.cameraController.camera2CameraControl ?: return
+        val camera2Options = cameraConfiguration.camera2Options
+        val stabMode = blazePrefs.getString("stabilization_mode", "hybrid") ?: "hybrid"
+        val oisPhoto = blazePrefs.getBoolean("ois_photo_stabilization", true)
+
+        val useOis = when (cameraConfiguration) {
+            is CameraConfiguration.Photo -> oisPhoto && (stabMode == "hybrid" || stabMode == "ois")
+            is CameraConfiguration.Video -> stabMode == "hybrid" || stabMode == "ois"
+            else -> false
+        }
+        val useEis = when (cameraConfiguration) {
+            is CameraConfiguration.Video -> cameraConfiguration.enableVideoStabilization &&
+                    (stabMode == "hybrid" || stabMode == "eis")
+            else -> false
+        }
+
+        val builder = CaptureRequestOptions.Builder()
+            .setFrameRate(
+                when (cameraConfiguration) {
+                    is CameraConfiguration.Video -> cameraConfiguration.videoFrameRate
+                    else -> null
+                }
+            )
+            .setVideoStabilizationMode(
+                if (useEis) VideoStabilizationMode.getMode(cameraConfiguration.camera)
+                else VideoStabilizationMode.OFF
+            )
+            .setCaptureRequestOption(
+                android.hardware.camera2.CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE,
+                if (useOis) android.hardware.camera2.CameraMetadata.LENS_OPTICAL_STABILIZATION_MODE_ON
+                else android.hardware.camera2.CameraMetadata.LENS_OPTICAL_STABILIZATION_MODE_OFF
+            )
+            .setEdgeMode(camera2Options.edgeMode)
+            .setNoiseReductionMode(camera2Options.noiseReductionMode)
+            .setShadingMode(camera2Options.shadingMode)
+            .setColorCorrectionAberrationMode(camera2Options.colorCorrectionAberrationMode)
+            .setDistortionCorrectionMode(camera2Options.distortionCorrectionMode)
+            .setHotPixelMode(camera2Options.hotPixelMode)
+
+        if (proModeActive) {
+            builder.setCaptureRequestOption(
+                android.hardware.camera2.CaptureRequest.CONTROL_AWB_MODE,
+                proWbValues[proWbIndex]
+            )
+            val focusDist = proFocusDistances[proFocusIndex]
+            if (focusDist != null) {
+                builder.setCaptureRequestOption(
+                    android.hardware.camera2.CaptureRequest.CONTROL_AF_MODE,
+                    android.hardware.camera2.CameraMetadata.CONTROL_AF_MODE_OFF
+                )
+                builder.setCaptureRequestOption(
+                    android.hardware.camera2.CaptureRequest.LENS_FOCUS_DISTANCE,
+                    focusDist
+                )
+            }
+            val iso = proIsoValues[proIsoIndex]
+            val shutterNs = proShutterNsValues[proShutterIndex]
+            if (iso != null || shutterNs != null) {
+                builder.setCaptureRequestOption(
+                    android.hardware.camera2.CaptureRequest.CONTROL_AE_MODE,
+                    android.hardware.camera2.CameraMetadata.CONTROL_AE_MODE_OFF
+                )
+                builder.setCaptureRequestOption(
+                    android.hardware.camera2.CaptureRequest.SENSOR_SENSITIVITY,
+                    iso ?: 200
+                )
+                builder.setCaptureRequestOption(
+                    android.hardware.camera2.CaptureRequest.SENSOR_EXPOSURE_TIME,
+                    shutterNs ?: 8_000_000L
+                )
+            }
+        }
+
+        camera2CameraControl.setCaptureRequestOptions(builder.build())
     }
 
