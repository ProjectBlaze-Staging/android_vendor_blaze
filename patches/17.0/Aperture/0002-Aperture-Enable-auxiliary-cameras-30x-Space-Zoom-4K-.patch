         launch {
             viewModel.zoomState.collectLatest { zoomState ->
-                zoomState?.takeIf { it.minZoomRatio != it.maxZoomRatio }?.let {
-                    zoomLevel.progress = it.linearZoom
+                zoomState?.takeIf {
+                    it.minZoomRatio != viewModel.getMaxEffectiveZoomRatio()
