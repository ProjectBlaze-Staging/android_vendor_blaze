diff --git a/target/product/gsi/init.gsi.rc b/target/product/gsi/init.gsi.rc
index 7f0ff16c01..da629c8962 100644
--- a/target/product/gsi/init.gsi.rc
+++ b/target/product/gsi/init.gsi.rc
@@ -4,13 +4,50 @@
 
 import /system/system_ext/etc/gsi/init.vndk-${ro.vndk.version:-nodef}.rc
 
+# Legacy Android 11-14 vendors (VNDK 29-34) predate KeyMint v4 (Android 15 / 202404)
+# and do not support setAdditionalAttestationInfo(MODULE_HASH). Gate keystore.module_hash.sent
+# strictly by legacy VNDK version so KeyMint v4+ devices still receive genuine MODULE_HASH.
+on property:ro.vndk.version=29
+    setprop keystore.module_hash.sent true
+
+on property:ro.vndk.version=30
+    setprop keystore.module_hash.sent true
+
+on property:ro.vndk.version=31
+    setprop keystore.module_hash.sent true
+
+on property:ro.vndk.version=32
+    setprop keystore.module_hash.sent true
+
+on property:ro.vndk.version=33
+    setprop keystore.module_hash.sent true
+
+on property:ro.vndk.version=34
+    setprop keystore.module_hash.sent true
+
 on post-fs-data
     # Universal Multi-Camera (Aux / Ultrawide / Telephoto) exposure for Xiaomi, OnePlus, Nothing, Realme
-    setprop vendor.camera.aux.packagelist "org.lineageos.aperture,com.android.camera,com.android.camera2,org.codeaurora.snapcam,com.google.android.GoogleCamera"
-    setprop persist.vendor.camera.privapp.list "org.lineageos.aperture,com.android.camera,com.android.camera2,org.codeaurora.snapcam,com.google.android.GoogleCamera"
+    setprop vendor.camera.aux.packagelist "org.lineageos.aperture,com.android.camera,com.android.camera2,org.codeaurora.snapcam"
+    setprop persist.vendor.camera.privapp.list "org.lineageos.aperture,com.android.camera,com.android.camera2,org.codeaurora.snapcam"
     setprop persist.sys.phh.include_all_cameras true
+    setprop debug.doze.aod true
+    setprop doze.display.supported false
+
+on property:sys.boot_completed=1
+    # Prevent broken router IPv6 RDNSS blackholes while keeping IPv4/IPv6 dual-stack fast
+    write /proc/sys/net/ipv6/conf/all/accept_ra_rdnss 0
+    write /proc/sys/net/ipv6/conf/default/accept_ra_rdnss 0
+    write /proc/sys/net/ipv6/conf/wlan0/accept_ra_rdnss 0
+
+on property:init.svc.wpa_supplicant=running
+    write /proc/sys/net/ipv6/conf/all/accept_ra_rdnss 0
+    write /proc/sys/net/ipv6/conf/default/accept_ra_rdnss 0
+    write /proc/sys/net/ipv6/conf/wlan0/accept_ra_rdnss 0
 
 on boot
+    # Prevent broken router IPv6 RDNSS blackholes on early Wi-Fi bring-up
+    write /proc/sys/net/ipv6/conf/all/accept_ra_rdnss 0
+    write /proc/sys/net/ipv6/conf/default/accept_ra_rdnss 0
     # Universal VoLTE / VoWiFi / VT IMS provisioning overrides for Qualcomm, MediaTek, Exynos & Tensor
     setprop persist.dbg.volte_avail_ovr 1
     setprop persist.dbg.vt_avail_ovr 1
@@ -65,3 +102,36 @@ on property:persist.sys.blaze.sf_gl_compat=0
     setprop debug.sf.auto_latch_unsignaled 1
     setprop debug.sf.disable_backpressure 0
 
+# Universal Samsung & Exynos Treble / GSI hardware compatibility (S21/S22/S23/S24 Exynos & OneUI vendor)
+on property:ro.product.vendor.manufacturer=samsung
